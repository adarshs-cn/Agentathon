# Copy to .env (git-ignored). Never commit real keys.
DEEPSEEK_API_KEY=

# --- Real Negotiation Agent (voice, via Twilio) ---
# Set MT02_REAL_VOICE=1 to swap the voice stub for a real outbound Twilio call.
# Leave unset (or 0) to keep the stub trio (the default for pytest and for the demo
# unless explicitly opted in).
MT02_REAL_VOICE=

# Real channels (MT02_REAL_VOICE / MT02_REAL_EMAIL) only ever activate in scenario mode by
# default -- the only mode with a human clicking Run on one event at a time. day mode's clock
# and live mode's always-on monitor both process events with nobody watching; wiring a real
# channel into either means unattended real calls/sends. Each channel needs its OWN separate
# acknowledgement to do that in day/live mode -- enabling one does NOT enable the other.
MT02_REAL_VOICE_IN_AUTO_MODES=
MT02_REAL_EMAIL_IN_AUTO_MODES=

# --- Sarvam (call-script generation) ---
SARVAM_API_KEY=
SARVAM_CONV_MODEL=
LLM_TIMEOUT=

# --- Twilio (outbound call). Leave blank to run in dry-run mode ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_VOICE=

# --- Safety: who may actually be dialled. NEVER a real/synthetic borrower number. ---
# Team phone that receives EVERY call during the demo (E.164 format).
DEMO_OVERRIDE_NUMBER=
# Or, instead, a comma-separated allow-list of real numbers you may dial.
# ALLOWED_NUMBERS=

# Trace output file (default: voicebot_trace.jsonl, relative to the process's cwd)
# VOICEBOT_TRACE=

# Required only on a Twilio trial account: the public URL Twilio fetches TwiML from.
# Run scripts/twiml_server.py + a tunnel (e.g. cloudflared) and put its https URL here.
# Expires/rotates every time the tunnel restarts.
PUBLIC_BASE_URL=

# Hard per-process cap on real calls actually placed (not dry-runs/duplicates). Protects
# DEMO_OVERRIDE_NUMBER from a burst of many different borrowers' negotiation events (e.g. a
# fast day-mode clock) each placing one real call with no volume limit otherwise. Default 5.
MT02_MAX_REAL_CALLS=

# --- Real Email Agent (Reminder/Servicing/Legal's "email" channel, via Brevo) ---
# Set MT02_REAL_EMAIL=1 to swap the email stub for a real Brevo send. Independent of
# MT02_REAL_VOICE -- enable either or both.
MT02_REAL_EMAIL=
BREVO_API_KEY=
EMAIL_FROM=
# Safety guard: only addresses in this comma-separated allowlist are ever emailed, UNLESS
# DEMO_OVERRIDE_EMAIL is set, in which case every email goes to that one address instead.
# NEVER a real dataset borrower's address by accident.
ALLOWED_EMAILS=
DEMO_OVERRIDE_EMAIL=
# Hard per-process cap on real emails actually sent, same purpose as MT02_MAX_REAL_CALLS.
MT02_MAX_REAL_EMAILS=
